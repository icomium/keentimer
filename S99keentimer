#!/bin/sh
PATH=/opt/bin:/opt/sbin:/sbin:/bin:/usr/sbin:/usr/bin
PIDFILE=/opt/var/run/keentimer.pid
LOG=/opt/var/log/keentimer.log
APP=/opt/share/keentimer/keentimer.py

start() {
  stop >/dev/null 2>&1
  mkdir -p /opt/var/run /opt/var/log
  nohup /opt/bin/python3 "$APP" >>"$LOG" 2>&1 &
  echo $! >"$PIDFILE"
  echo "keentimer started (port 3000)"
}
stop() {
  [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
  rm -f "$PIDFILE"
  echo "keentimer stopped"
}
case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
